APP_NAME=CodeLens
APP_VERSION=0.1.0
DEBUG=true

# Postgres with the pgvector extension enabled (Neon's free tier works)
DATABASE_URL=postgresql://user:password@host/dbname

# GitHub App used for auth, webhooks, and posting PR comments
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./your-github-app-private-key.pem
GITHUB_INSTALLATION_ID=123456
# Optional: personal access token, only needed for backfilling public repos
GITHUB_PAT=

# Redis for Celery (Upstash's free tier works)
REDIS_URL=rediss://default:password@host:6379

VOYAGE_API_KEY=
GROQ_API_KEY=

# Optional: verifies GitHub webhook signatures. Leave blank to skip verification locally.
WEBHOOK_SECRET=
