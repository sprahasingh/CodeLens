APP_NAME=CodeLens
APP_VERSION=0.1.0
DEBUG=true

# Postgres with the pgvector extension enabled (Neon's free tier works)
DATABASE_URL=postgresql://user:password@host/dbname

# GitHub App used for auth, webhooks, and posting PR comments.
# Locally / with Docker Compose, use GITHUB_PRIVATE_KEY_PATH (a file path).
# On a platform that can't mount local files (e.g. Fly.io), set
# GITHUB_PRIVATE_KEY to the raw PEM content instead. Only one is needed.
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./your-github-app-private-key.pem
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=123456
# Optional: personal access token, only needed for backfilling public repos
GITHUB_PAT=

# Redis for Celery (Upstash's free tier works)
REDIS_URL=rediss://default:password@host:6379

VOYAGE_API_KEY=
GROQ_API_KEY=
# Groq requests stay serial by default. Retries and per-PR call count are bounded.
GROQ_MAX_CONCURRENCY=1
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_SECONDS=20
GROQ_RETRY_BASE_SECONDS=1
GROQ_RETRY_MAX_SECONDS=20
GROQ_RATE_LIMIT_COOLDOWN_SECONDS=60
GROQ_DEFERRED_MAX_ATTEMPTS=3
GROQ_DEFERRED_MAX_ELAPSED_SECONDS=3600
GROQ_MAX_EVIDENCE_COMMENTS_PER_GROUP=5
GROQ_MAX_EVIDENCE_CHARS_PER_GROUP=10000
GROQ_MAX_CHANGED_CONTEXT_CHARS=12000
GROQ_MAX_CALLS_PER_PR=12
MAX_PR_HUNKS=50
REVIEW_TASK_EXPIRES_SECONDS=1800
REVIEW_TASK_MAX_RETRIES=2
REVIEW_CLAIM_LEASE_SECONDS=1200
REVIEW_MAX_ATTEMPTS=5
REVIEW_RECONCILE_INTERVAL_SECONDS=60
GITHUB_COMMENT_MAX_RETRIES=2
GITHUB_COMMENT_RETRY_BASE_SECONDS=1
GITHUB_COMMENT_RETRY_MAX_SECONDS=20
WORKER_HEALTH_CHECK_SECONDS=30
WORKER_HEALTH_FAILURES_BEFORE_RESTART=5
WORKER_HEALTH_CHECK_TIMEOUT_SECONDS=5
WORKER_RESTART_STABILITY_SECONDS=600
WORKER_DISK_WARNING_PERCENT=85
WORKER_SHUTDOWN_GRACE_SECONDS=970
NTFY_TOPIC=

# Optional: verifies GitHub webhook signatures. Leave blank to skip verification locally.
WEBHOOK_SECRET=
